<view xhs:if="{{ready}}" class="shell">
<view xhs:if="{{screen === 'home'}}" class="journey-home">
 <view class="journey-heading"><view class="eyebrow">北宋蜀地 · 行商札记</view><view class="home-title">蜀地钱路</view><view class="home-subtitle">钱有轻重，路有取舍。</view></view>
 <view class="continue-card"><view class="story-visual"><image class="vignette-scene" src="{{narrative.scene}}" style="{{'object-position:' + narrative.crop}}" mode="aspectFill"/><view class="vignette-wash"></view><image class="hero-portrait" src="{{guide.portrait}}" mode="aspectFit"/><view class="vignette-caption"><text class="eyebrow">{{narrative.tag}}</text><text>一程商路 · 一笔人情</text></view></view>
 <view class="continue-copy"><view class="row"><text class="eyebrow">第 {{level.number}} 关 · {{narrative.tag}}</text><text class="progress-count">已完成 {{completedCount}} / {{chapterCount}}</text></view><view class="continue-title">{{level.title}}</view><view class="continue-mission">{{level.mission}}</view><view class="journey-progress"><view xhs:for="{{chapters}}" xhs:key="id" class="progress-dot {{item.completed ? 'done' : item.id === level.id ? 'active' : ''}}"></view></view><view class="journey-status">{{journeyStatus}}</view></view></view>
 <view class="home-actions"><button class="primary" data-action="start" bindtap="onAction">继续章节</button><view class="action-buttons"><button class="secondary" data-action="chapters" bindtap="onAction">选择章节</button><button class="secondary" data-action="history" bindtap="onAction">交子史话</button></view></view>
</view>
<view xhs:elif="{{screen === 'chapters'}}" class="chapters-screen narrative-chapters"><view class="row"><view><view class="eyebrow">从一袋铁钱，到独当一面</view><view class="chapter-index-title">行商六记</view></view><button class="text-button" data-action="home" bindtap="onAction">返回</button></view><view class="chapter-progress">已办妥 {{completedCount}} 笔委托 · 共 {{chapterCount}} 章</view><view class="chapter-grid"><button xhs:for="{{chapters}}" xhs:key="id" class="chapter-card {{item.completed ? 'completed' : ''}}" disabled="{{item.locked}}" data-action="{{'level:' + item.id}}" bindtap="onAction"><view class="chapter-thumbnail"><image src="{{item.scene}}" style="{{item.artStyle}}" mode="aspectFill"/><text class="chapter-number">0{{item.number}}</text><text class="chapter-state">{{item.locked ? '未解锁' : item.completed ? '已完成' : '启程'}}</text></view><view class="chapter-card-copy"><view class="chapter-card-title">{{item.title}}</view><view class="chapter-card-subtitle">{{item.subtitle}}</view></view></button></view></view>
<view xhs:elif="{{screen === 'intro'}}" class="chapter-opening"><view class="opening-heading"><view class="eyebrow">第 {{level.number}} 关 / {{narrative.tag}}</view><view class="opening-title">{{level.title}}</view><view class="opening-line">{{narrative.line}}</view></view><view class="story-visual"><image class="vignette-scene" src="{{narrative.scene}}" style="{{'object-position:' + narrative.crop}}" mode="aspectFill"/><view class="vignette-wash"></view><image class="hero-portrait" src="{{narrative.speaker.portrait}}" mode="aspectFit"/><view class="vignette-caption"><text class="eyebrow">{{narrative.tag}}</text><text>一程商路 · 一笔人情</text></view></view><view class="commission-card"><view class="speaker-line"><text class="speaker-name">{{narrative.speaker.name}}</text><text class="speaker-role">{{narrative.speaker.role}}</text></view><view class="commission-dialogue">{{narrative.opening}}</view><view class="commission-details"><view class="commission-goal">{{level.mission}}</view><view class="commission-limits"><text>{{level.maxSteps}} 步内送达</text><text>钱袋 {{level.capacity}} 格</text></view></view></view><view class="opening-actions"><button class="primary" data-action="play" bindtap="onAction">开始委托</button><button class="text-button" data-action="skip-intro" bindtap="onAction">跳过教学，直接开始</button></view></view>
<view xhs:elif="{{s.status !== 'playing'}}" class="result-screen"><view class="eyebrow">第 {{level.number}} 关 · {{level.title}}</view><view class="cover-title">{{s.status === 'won' ? '委托完成' : '行程未成'}}</view><view class="character-response"><image class="portrait" src="{{outroActor.portrait}}" mode="aspectFill"/><view class="response-copy"><view class="response-name">{{outroActor.name}}</view><view class="response-body">{{outroText}}</view></view></view><view xhs:if="{{s.status !== 'won'}}" class="result-copy">{{resultText}}</view><view class="result-stats"><view>行动<view>{{s.stepsUsed}} / {{level.maxSteps}}</view></view><view>剩余资金<view>{{total}}</view></view><view>费用<view>{{fee}}</view></view></view><view class="muted">{{remainingText}}</view><view class="path">{{pathText}}</view><view class="ledger"><view xhs:for="{{ledger}}" xhs:key="id" class="ledger-row">{{item.text}}</view></view><view xhs:if="{{s.status === 'won'}}" class="route-review">{{routeReview}}<view xhs:if="{{ending}}">{{ending}}</view></view><view class="result-buttons"><button xhs:if="{{s.status === 'won'}}" class="primary" data-action="next" bindtap="onAction">{{nextLabel}}</button><view class="action-buttons"><button class="secondary" data-action="retry" bindtap="onAction">重新挑战</button><button class="secondary" data-action="undo" bindtap="onAction" disabled="{{!canUndo}}">撤销上一步</button></view><button class="text-button" data-action="chapters" bindtap="onAction">返回章节</button></view></view>
<block xhs:else>
<view class="panel-terrain"><image src="{{backdrop}}" mode="widthFix"/></view>
<view class="topbar"><view class="row"><view><view class="brand">蜀地钱路</view><view class="chapter">第 {{level.number}} 关 · {{level.title}}</view></view><view class="top-actions"><button class="menu-button" data-action="menu" bindtap="onAction">菜单</button></view></view><view class="mission"><text>{{level.mission}}</text><view class="journey-actions"><text class="steps">{{s.stepsUsed}} / {{level.maxSteps}} 步</text><button class="undo-action" data-action="undo" bindtap="onAction" disabled="{{!canUndo}}"><text class="undo-symbol">↶</text><text class="undo-label">撤销</text></button></view></view></view>
<view class="map-stage"><view class="scene-continuation"><view class="continuation-frame"><image class="continuation-art" src="{{backdrop}}" mode="aspectFill"/></view></view><view class="map reference-map {{modular ? 'modular-map' : ''}}"><view class="scene-art"><view class="scene-terrain"><view xhs:for="{{terrainTiles}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view><view class="scene-buildings"><view xhs:for="{{artRegions}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view></view><view class="road-layer"><view xhs:for="{{routeSegments}}" xhs:key="id" class="route route-dash" style="{{item.style}}"></view></view><view class="art-hit-layer"><button xhs:for="{{artRegions}}" xhs:key="id" class="atlas-building-hit" style="{{item.style}}" data-building="{{item.id}}" bindtap="onMove"></button></view><view class="interaction-layer"><button xhs:for="{{nodes}}" xhs:key="id" class="node scene-node {{item.current ? 'current' : ''}} {{item.reachable ? 'reachable' : ''}}" style="{{item.style}}" data-node="{{item.id}}" bindtap="onMove"><view class="scene-placard">{{item.name}}</view><view class="scene-pin"><view></view></view><view xhs:if="{{item.current}}" class="you-marker">所在</view></button></view></view></view>
<view class="dock"><view class="wallet"><view xhs:for="{{resources}}" xhs:key="id" class="walletitem"><view xhs:if="{{item.asset}}" class="money-object"><image class="resource-icon" src="{{'/assets/generated/' + item.asset + '.png'}}" mode="aspectFit"/><text xhs:if="{{item.seal}}" class="note-seal {{item.id}}">{{item.seal}}</text></view><view xhs:else class="resource-icon goods-sprite"><image src="/assets/v2/goods.png" style="{{item.spriteStyle}}" mode="scaleToFill"/></view><view><view class="label">{{item.name}}</view><view class="resource-number">{{item.value}}</view></view></view><view class="load"><view class="label">随身负重</view><view>{{weight}} / {{level.capacity}}</view><view class="capacity"><view xhs:for="{{slots}}" xhs:key="id" class="slot {{item.kind}}"></view></view></view></view><view class="cargo-strip"><view xhs:for="{{cargo}}" xhs:key="id" class="cargo-item"><view xhs:if="{{item.asset}}" class="money-object"><image class="resource-icon" src="{{'/assets/generated/' + item.asset + '.png'}}" mode="aspectFit"/><text xhs:if="{{item.seal}}" class="note-seal {{item.id}}">{{item.seal}}</text></view><view xhs:else class="resource-icon goods-sprite"><image src="/assets/v2/goods.png" style="{{item.spriteStyle}}" mode="scaleToFill"/></view><text>{{item.name}} {{item.value}}</text></view></view>
<view xhs:if="{{message}}" class="feedback {{error ? 'error' : ''}}">{{message}}</view><view class="action-panel {{panel.kind}}"><view class="panel-heading"><view>{{panel.title}}</view><view class="muted">{{panel.meta}}</view></view><button class="ask-guide" data-action="hint" bindtap="onAction"><image src="{{guide.portrait}}" mode="aspectFill"/><text>问阿禾</text></button><view class="payment-controls"><view xhs:for="{{panel.steppers}}" xhs:key="key" class="stepper {{item.key === 'x' ? 'exchange-stepper' : ''}}"><button class="small" data-action="{{item.minus}}" bindtap="onAction" disabled="{{item.minDisabled}}">−</button><view class="stepper-value">{{item.label}}<view xhs:if="{{item.key !== 'x'}}" class="resource-number">{{item.value}}</view></view><button class="small" data-action="{{item.plus}}" bindtap="onAction" disabled="{{item.maxDisabled}}">+</button></view></view><view xhs:if="{{panel.choices.length}}" class="choice-buttons"><button xhs:for="{{panel.choices}}" xhs:key="id" class="{{item.selected ? 'primary' : 'secondary'}}" data-action="{{item.id}}" bindtap="onAction">{{item.label}}</button></view><view class="preview">{{panel.preview}}</view><view class="action-buttons"><button xhs:for="{{panel.buttons}}" xhs:key="id" class="{{item.kind}}" data-action="{{item.id}}" bindtap="onAction" disabled="{{item.disabled}}">{{item.label}}</button></view></view>
</view>
</block>
<view xhs:if="{{modal.dialogue}}" class="modal-backdrop narrative-backdrop {{modal.important ? 'important-dialogue' : 'teaching-backdrop'}}"><view class="rules-dialog dialogue-card"><image class="dialogue-portrait" src="{{modal.actor.portrait}}" mode="aspectFit"/><view class="dialogue-copy"><view class="eyebrow">{{modal.actor.role}}</view><view class="dialogue-name">{{modal.actor.name}}</view><view class="dialogue-body">{{modal.body}}</view></view><view class="dialog-controls"><block xhs:if="{{modal.kind === 'lesson'}}"><button class="secondary" data-action="skip-tutorial" bindtap="onAction">跳过教学</button><button class="primary" data-action="lesson-next" bindtap="onAction">继续</button></block><button xhs:else class="primary" data-action="close" bindtap="onAction">继续行商</button></view></view></view>
<view xhs:elif="{{modal.kind === 'menu'}}" class="modal-backdrop menu-backdrop"><view class="rules-dialog journey-menu"><view class="row"><view class="rule-title">行商手记</view><button class="text-button" data-action="close" bindtap="onAction">收起</button></view><view class="journey-menu-items"><button class="secondary" data-action="rules" bindtap="onAction">查看规则</button><button class="secondary" data-action="replay" bindtap="onAction">重听委托</button><button class="secondary" data-action="retry" bindtap="onAction">重新启程</button><button class="secondary" data-action="chapters" bindtap="onAction">选择章节</button></view></view></view>
<view xhs:elif="{{modal}}" class="modal-backdrop {{modal.kind === 'lesson' ? 'teaching-backdrop' : ''}}"><view class="rules-dialog"><view class="row"><view class="eyebrow">行商札记</view><button class="text-button" data-action="close" bindtap="onAction">关闭</button></view><view class="rule-title">{{modal.title}}</view><view xhs:if="{{modal.flavor}}" class="node-flavor">{{modal.flavor}}</view><view class="rule-body">{{modal.body}}</view><view class="dialog-controls">
<block xhs:if="{{modal.kind === 'move'}}"><button class="secondary" data-action="close" bindtap="onAction">返回</button><button xhs:if="{{modal.canMove}}" class="primary" data-action="confirm-move" bindtap="onAction">确认前往</button></block>
<block xhs:elif="{{modal.kind === 'lesson'}}"><button class="secondary" data-action="skip-tutorial" bindtap="onAction">跳过教学</button><button class="primary" data-action="lesson-next" bindtap="onAction">知道了</button></block>
<block xhs:elif="{{modal.kind === 'hint'}}"><button class="secondary" data-action="close" bindtap="onAction">返回游戏</button><button class="primary" data-action="hint-next" bindtap="onAction" disabled="{{hintLevel >= 2}}">{{hintLevel === 1 ? '查看参考解法' : '再提示一点'}}</button></block>
<block xhs:elif="{{modal.kind === 'rules' || modal.kind === 'history'}}"><button class="secondary" data-action="{{modal.kind === 'rules' ? 'rule-prev' : 'history-prev'}}" bindtap="onAction" disabled="{{modal.page === 0}}">上一页</button><button class="primary" data-action="{{modal.page === modal.count-1 ? 'close' : modal.kind === 'rules' ? 'rule-next' : 'history-next'}}" bindtap="onAction">{{modal.page === modal.count-1 ? '返回游戏' : '下一页'}}</button></block>
<button xhs:else class="primary" data-action="close" bindtap="onAction">返回</button>
</view></view></view>
</view>

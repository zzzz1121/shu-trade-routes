<view xhs:if="{{ready}}" class="shell">
<view xhs:if="{{screen === 'home'}}" class="journey-home">
 <view class="journey-heading"><button disabled="{{moving}}" class="text-button home-sound" data-action="sounds" bindtap="onAction">声音</button><view class="eyebrow">北宋蜀地 · 行商札记</view><view class="home-title">蜀地钱路</view><view class="home-subtitle">钱有轻重，路有取舍。</view></view>
 <view class="continue-card"><view class="story-visual"><view class="vignette-scene scene-window"><image src="{{narrative.scene}}" style="{{narrative.sceneStyle}}" mode="scaleToFill"/></view><view class="vignette-wash"></view><view class="hero-portrait actor-frame" style="{{guide.aspectStyle}}"><image src="{{guide.portrait}}" style="{{guide.frameStyle}}" mode="scaleToFill"/></view><view class="vignette-caption"><text class="eyebrow">{{narrative.tag}}</text><text>{{narrative.subtitle}}</text></view></view>
 <view class="continue-copy"><view class="row"><text class="eyebrow">第 {{level.number}} 关 · {{narrative.tag}}</text><text class="progress-count">已完成 {{completedCount}} / {{chapterCount}}</text></view><view class="continue-title">{{level.title}}</view><view class="continue-mission">{{level.mission}}</view><view class="journey-progress"><view xhs:for="{{chapters}}" xhs:key="id" class="progress-dot {{item.completed ? 'done' : item.id === level.id ? 'active' : ''}}"></view></view><view class="journey-status">{{journeyStatus}}</view></view></view>
 <view class="home-actions"><button disabled="{{moving}}" class="primary" data-action="{{canResume ? 'resume' : 'start'}}" bindtap="onAction">{{canResume ? '继续行程' : '继续章节'}}</button><view class="action-buttons"><button disabled="{{moving}}" class="secondary" data-action="chapters" bindtap="onAction">选择章节</button><button disabled="{{moving}}" class="secondary" data-action="history" bindtap="onAction">交子史话</button></view></view>
</view>
<view xhs:elif="{{screen === 'chapters'}}" class="chapter-journey"><view class="row"><view><view class="eyebrow">沿着蜀地商路，记下六段故事</view><view class="journey-title">行商六记</view></view><button disabled="{{moving}}" class="text-button" data-action="home" bindtap="onAction">首页</button></view><view class="journey-caption"><text>一程一约，慢慢走来</text><text>已完成 {{completedCount}} / {{chapterCount}}</text></view><view class="chapter-landscape chapter-card-grid"><image class="chapter-ground" src="{{chapterBackdrop}}" mode="aspectFill"/><view xhs:if="{{false}}" class="chapter-roads"><view xhs:for="{{chapterRoads}}" xhs:key="id" class="chapter-road {{item.reverse ? 'reverse' : ''}} {{item.done ? 'done' : ''}}" style="{{item.style}}"></view></view><button xhs:for="{{chapters}}" xhs:key="id" class="chapter-stop chapter-card {{item.completed ? 'completed' : ''}} {{item.locked ? 'locked' : ''}} {{item.active ? 'active' : ''}}"  data-action="{{'level:' + item.id}}" disabled="{{moving || (item.locked)}}" bindtap="onAction"><view class="chapter-island"><view class="chapter-sprite"><image src="{{item.scene}}" style="{{item.artStyle}}" mode="scaleToFill"/></view></view><view class="stop-label"><view class="stop-title"><text class="stop-number">0{{item.number}}</text><text class="stop-name">{{item.title}}</text></view><view class="stop-caption"><text class="chapter-subtitle">{{item.subtitle}}</text><text class="chapter-state">{{item.locked ? '未解锁' : item.completed ? '已完成' : '启程'}}</text></view></view></button></view></view>
<view xhs:elif="{{screen === 'intro'}}" class="chapter-opening"><view class="opening-heading"><view class="eyebrow">第 {{level.number}} 关 / {{narrative.tag}}</view><view class="opening-title">{{level.title}}</view><view class="opening-line">{{narrative.line}}</view></view><view class="story-visual"><view class="vignette-scene scene-window"><image src="{{narrative.scene}}" style="{{narrative.sceneStyle}}" mode="scaleToFill"/></view><view class="vignette-wash"></view><view class="hero-portrait actor-frame" style="{{narrative.speaker.aspectStyle}}"><image src="{{narrative.speaker.portrait}}" style="{{narrative.speaker.frameStyle}}" mode="scaleToFill"/></view><view class="vignette-caption"><text class="eyebrow">{{narrative.tag}}</text><text>{{narrative.subtitle}}</text></view></view><view class="commission-card"><view class="speaker-line"><text class="speaker-name">{{narrative.speaker.name}}</text><text class="speaker-role">{{narrative.speaker.role}}</text></view><view class="commission-dialogue">{{narrative.opening}}</view><view class="commission-details"><view class="commission-goal">{{level.mission}}</view><view class="commission-limits"><text>{{level.maxSteps}} 步内送达</text><text>钱袋 {{level.capacity}} 格</text></view></view></view><view class="approach-picker"><text>行商打算 · 可选</text><view><button disabled="{{moving}}" class="{{plan === 'speed' ? 'primary' : 'secondary'}}" data-action="plan:speed" bindtap="onAction">{{approach.speed}}</button><button disabled="{{moving}}" class="{{plan === 'economy' ? 'primary' : 'secondary'}}" data-action="plan:economy" bindtap="onAction">{{approach.economy}}</button></view></view><view class="opening-actions"><button disabled="{{moving}}" class="primary" data-action="play" bindtap="onAction">开始委托</button><button disabled="{{moving}}" class="text-button" data-action="skip-intro" bindtap="onAction">跳过教学，直接开始</button></view></view>
<view xhs:elif="{{s.status !== 'playing'}}" class="result-screen"><view class="eyebrow">第 {{level.number}} 关 · {{level.title}}</view><view class="cover-title">{{s.status === 'won' ? '委托完成' : '行程未成'}}</view><view class="character-response {{historyLine ? 'history-response' : ''}}"><view class="portrait actor-frame" style="{{outroActor.aspectStyle}}"><image src="{{outroActor.portrait}}" style="{{outroActor.frameStyle}}" mode="scaleToFill"/></view><view class="response-copy"><view class="response-name">{{outroActor.name}}</view><view class="response-body">{{outroText}}</view><view xhs:if="{{historyLine}}" class="history-line">{{historyLine}}</view></view></view><view xhs:if="{{s.status !== 'won'}}" class="result-copy">{{resultText}}</view><view class="result-stats"><view>行动<view>{{s.stepsUsed}} / {{level.maxSteps}}</view></view><view>剩余资金<view>{{total}}</view></view><view>费用<view>{{fee}}</view></view></view><view class="muted">{{remainingText}}</view><view class="path">{{pathText}}</view><view class="ledger"><view xhs:for="{{ledger}}" xhs:key="id" class="ledger-row">{{item.text}}</view></view><view xhs:if="{{s.status === 'won'}}" class="route-review">{{routeReview}}<view xhs:if="{{ending}}">{{ending}}</view></view><view xhs:if="{{plan}}" class="approach-result">{{approach.label}} · {{approach.met ? '也办到了' : '下趟再试试'}}</view><view class="result-buttons"><button disabled="{{moving}}" xhs:if="{{s.status === 'won'}}" class="primary" data-action="next" bindtap="onAction">{{nextLabel}}</button><view class="action-buttons"><button disabled="{{moving}}" class="secondary" data-action="retry" bindtap="onAction">重新挑战</button><button class="secondary" data-action="undo" bindtap="onAction" disabled="{{moving || (!canUndo)}}">{{s.status === 'won' ? '返回交付前' : '撤回上一步'}}</button></view><button disabled="{{moving}}" class="text-button" data-action="chapters" bindtap="onAction">返回章节</button></view></view>
<block xhs:else>
<view class="panel-terrain"><image src="{{backdrop}}" mode="widthFix"/></view>
<view class="topbar"><view class="row"><view><view class="brand">蜀地钱路</view><view class="chapter">第 {{level.number}} 关 · {{level.title}}</view></view><view class="top-actions"><button disabled="{{moving}}" class="menu-button" data-action="menu" bindtap="onAction">菜单</button></view></view><view class="mission"><text>{{level.mission}}</text><view class="journey-actions"><text class="steps">{{s.stepsUsed}} / {{level.maxSteps}} 步</text><button class="undo-action" data-action="undo" bindtap="onAction" disabled="{{moving || (!canUndo)}}"><text class="undo-symbol">↶</text><text class="undo-label">撤销</text></button></view></view></view>
<view class="map-stage"><view class="scene-continuation"><view class="continuation-frame"><image class="continuation-art" src="{{backdrop}}" mode="aspectFill"/></view></view><view class="map reference-map {{modular ? 'modular-map' : ''}} {{moving ? 'travelling' : ''}}"><view class="scene-art"><view class="scene-terrain"><view xhs:for="{{terrainTiles}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view><view class="scene-buildings"><view xhs:for="{{artRegions}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view></view><view class="road-layer"><view xhs:for="{{routeSegments}}" xhs:key="id" class="route route-dash {{item.walking ? 'walking-path' : ''}}" style="{{item.style}}"></view></view><view class="art-hit-layer"><button disabled="{{moving}}" xhs:for="{{artRegions}}" xhs:key="id" class="atlas-building-hit" style="{{item.style}}" data-building="{{item.id}}" bindtap="onMove"></button></view><view class="interaction-layer"><button disabled="{{moving}}" xhs:for="{{nodes}}" xhs:key="id" class="node scene-node {{item.current ? 'current' : ''}} {{item.reachable ? 'reachable' : ''}}" style="{{item.style}}" data-node="{{item.id}}" bindtap="onMove"><view class="scene-placard">{{item.name}}</view><view class="scene-pin"><view></view></view><view xhs:if="{{item.current}}" class="you-marker">所在</view></button></view><view xhs:if="{{showTraveler}}" class="traveler {{traveler.phase}}" style="{{traveler.style}}"><view class="traveler-shadow"></view><view class="traveler-figure"><view class="traveler-pack"></view><view class="traveler-leg leg-left"></view><view class="traveler-leg leg-right"></view><view class="traveler-coat"></view><view class="traveler-head"></view><view class="traveler-hat"></view></view></view></view></view>
<view class="dock"><view class="wallet"><view xhs:for="{{resources}}" xhs:key="id" class="walletitem"><view xhs:if="{{item.asset}}" class="money-object"><image class="resource-icon" src="{{'/assets/generated/' + item.asset + '.png'}}" mode="aspectFit"/><text xhs:if="{{item.seal}}" class="note-seal {{item.id}}">{{item.seal}}</text></view><view xhs:else class="resource-icon goods-sprite"><image src="/assets/v2/goods.png" style="{{item.spriteStyle}}" mode="scaleToFill"/></view><view><view class="label">{{item.name}}</view><view class="resource-number">{{item.value}}</view></view></view><view class="load"><view class="label">随身负重</view><view>{{weight}} / {{level.capacity}}</view><view class="capacity"><view xhs:for="{{slots}}" xhs:key="id" class="slot {{item.kind}}"></view></view></view></view><view class="cargo-strip"><view xhs:for="{{cargo}}" xhs:key="id" class="cargo-item"><view xhs:if="{{item.asset}}" class="money-object"><image class="resource-icon" src="{{'/assets/generated/' + item.asset + '.png'}}" mode="aspectFit"/><text xhs:if="{{item.seal}}" class="note-seal {{item.id}}">{{item.seal}}</text></view><view xhs:else class="resource-icon goods-sprite"><image src="/assets/v2/goods.png" style="{{item.spriteStyle}}" mode="scaleToFill"/></view><text>{{item.name}} {{item.value}}</text></view></view>
<view xhs:if="{{message}}" class="feedback {{error ? 'error' : ''}}">{{message}}</view><view class="action-panel {{panel.kind}}"><view class="panel-heading"><view>{{panel.title}}</view><view class="muted">{{panel.meta}}</view></view><button disabled="{{moving}}" class="ask-guide" data-action="hint" bindtap="onAction"><view class="guide-face actor-frame" style="{{guide.aspectStyle}}"><image src="{{guide.portrait}}" style="{{guide.frameStyle}}" mode="scaleToFill"/></view><text>问阿禾</text></button><view class="payment-controls"><view xhs:for="{{panel.steppers}}" xhs:key="key" class="stepper {{item.key === 'x' ? 'exchange-stepper' : ''}}"><button class="small" data-action="{{item.minus}}" bindtap="onAction" disabled="{{moving || (item.minDisabled)}}">−</button><view class="stepper-value">{{item.label}}<view xhs:if="{{item.key !== 'x'}}" class="resource-number">{{item.value}}</view></view><button class="small" data-action="{{item.plus}}" bindtap="onAction" disabled="{{moving || (item.maxDisabled)}}">+</button></view></view><view xhs:if="{{panel.choices.length}}" class="choice-buttons"><button disabled="{{moving}}" xhs:for="{{panel.choices}}" xhs:key="id" class="{{item.selected ? 'primary' : 'secondary'}}" data-action="{{item.id}}" bindtap="onAction">{{item.label}}</button></view><view class="preview">{{panel.preview}}</view><view class="action-buttons"><button xhs:for="{{panel.buttons}}" xhs:key="id" class="{{item.kind}}" data-action="{{item.id}}" bindtap="onAction" disabled="{{moving || (item.disabled)}}">{{item.label}}</button></view></view>
</view>
</block>
<view xhs:if="{{modal.dialogue}}" class="modal-backdrop narrative-backdrop {{modal.important ? 'important-dialogue' : 'teaching-backdrop'}}"><view class="rules-dialog dialogue-card"><view class="dialogue-portrait actor-frame" style="{{modal.actor.aspectStyle}}"><image src="{{modal.actor.portrait}}" style="{{modal.actor.frameStyle}}" mode="scaleToFill"/></view><view class="dialogue-copy"><view class="eyebrow">{{modal.actor.role}}</view><view class="dialogue-name">{{modal.actor.name}}</view><view class="dialogue-body">{{modal.body}}</view></view><view class="dialog-toolbar"><button disabled="{{moving}}" class="text-button" data-action="backlog" bindtap="onAction">回看</button><button disabled="{{moving}}" xhs:if="{{modal.kind === 'story'}}" class="text-button" data-action="dialogue-skip" bindtap="onAction">跳过</button></view><view class="dialog-controls"><block xhs:if="{{modal.kind === 'lesson'}}"><button disabled="{{moving}}" class="secondary" data-action="skip-tutorial" bindtap="onAction">跳过教学</button><button disabled="{{moving}}" class="primary" data-action="lesson-next" bindtap="onAction">继续</button></block><block xhs:elif="{{modal.kind === 'hint'}}"><button disabled="{{moving}}" class="secondary" data-action="close" bindtap="onAction">返回游戏</button><button class="primary" data-action="hint-next" bindtap="onAction" disabled="{{moving || (hintLevel >= 2)}}">{{hintLevel === 1 ? '查看参考解法' : '再提示一点'}}</button></block><block xhs:elif="{{modal.kind === 'story'}}"><button disabled="{{moving}}" xhs:if="{{!modal.atEnd}}" class="primary" data-action="dialogue-next" bindtap="onAction">继续</button><block xhs:else><button disabled="{{moving}}" xhs:for="{{modal.choices}}" xhs:key="id" class="secondary" data-action="{{'choice:' + item.id}}" bindtap="onAction">{{item.label}}</button></block></block><button disabled="{{moving}}" xhs:else class="primary" data-action="close" bindtap="onAction">继续行商</button></view></view></view>
<view xhs:elif="{{modal.kind === 'backlog'}}" class="modal-backdrop"><view class="rules-dialog backlog-dialog"><view class="row"><view class="rule-title">对话回看</view><button disabled="{{moving}}" class="text-button" data-action="backlog-return" bindtap="onAction">返回对白</button></view><scroll-view scroll-y class="backlog-scroll"><view xhs:if="{{!backlog.length}}">听过的对白会记在这里。</view><view xhs:for="{{backlog}}" xhs:key="index" class="backlog-entry"><view class="backlog-portrait actor-frame" style="{{item.actor.aspectStyle}}"><image src="{{item.actor.portrait}}" style="{{item.actor.frameStyle}}" mode="scaleToFill"/></view><view><view>{{item.speaker}}</view><view class="backlog-text">{{item.text}}</view></view></view></scroll-view></view></view>
<view xhs:elif="{{modal.kind === 'sound'}}" class="modal-backdrop sound-backdrop"><view class="rules-dialog sound-dialog"><view class="row"><view class="rule-title">声音</view><button class="text-button" data-action="close" bindtap="onAction">返回</button></view><view class="sound-setting"><text>操作音效</text><button class="{{soundSettings.effectsEnabled ? 'primary' : 'secondary'}}" data-action="sound:effects" bindtap="onAction">{{soundSettings.effectsEnabled ? '开启' : '关闭'}}</button></view><view class="sound-setting"><text>环境氛围</text><button class="{{soundSettings.ambienceEnabled ? 'primary' : 'secondary'}}" data-action="sound:ambience" bindtap="onAction">{{soundSettings.ambienceEnabled ? '开启' : '关闭'}}</button></view><view class="sound-setting sound-volume"><text>音量</text><button class="small" disabled="{{volumePercent === 0}}" data-action="sound:down" bindtap="onAction">−</button><text class="volume-value">{{volumePercent}}%</text><button class="small" disabled="{{volumePercent === 100}}" data-action="sound:up" bindtap="onAction">+</button></view></view></view>
<view xhs:elif="{{modal.kind === 'menu'}}" class="modal-backdrop menu-backdrop"><view class="rules-dialog journey-menu"><view class="row"><view class="rule-title">行商手记</view><button disabled="{{moving}}" class="text-button" data-action="close" bindtap="onAction">收起</button></view><view class="journey-menu-items"><button disabled="{{moving}}" class="secondary" data-action="rules" bindtap="onAction">查看规则</button><button disabled="{{moving}}" class="secondary" data-action="replay" bindtap="onAction">重听委托</button><button disabled="{{moving}}" class="secondary" data-action="backlog" bindtap="onAction">对话回看</button><button disabled="{{moving}}" class="secondary" data-action="retry" bindtap="onAction">重新启程</button><button disabled="{{moving}}" class="secondary" data-action="chapters" bindtap="onAction">选择章节</button><button disabled="{{moving}}" class="secondary" data-action="history" bindtap="onAction">交子史话</button><button disabled="{{moving}}" class="secondary" data-action="sounds" bindtap="onAction">声音设置</button><button disabled="{{moving}}" class="secondary" data-action="home" bindtap="onAction">回到首页</button></view></view></view>
<view xhs:elif="{{modal}}" class="modal-backdrop {{modal.kind}}-backdrop"><view class="rules-dialog"><view class="row"><view class="eyebrow">行商札记</view><button disabled="{{moving}}" class="text-button" data-action="close" bindtap="onAction">关闭</button></view><view class="rule-title">{{modal.title}}</view><view xhs:if="{{modal.flavor}}" class="node-flavor"><view class="node-portrait actor-frame" style="{{modal.actor.aspectStyle}}"><image src="{{modal.actor.portrait}}" style="{{modal.actor.frameStyle}}" mode="scaleToFill"/></view><text>{{modal.flavor}}</text></view><view class="rule-body">{{modal.body}}</view><view class="dialog-controls">
<block xhs:if="{{modal.kind === 'history'}}"><button class="secondary" data-action="history-prev" bindtap="onAction" disabled="{{moving || (modal.page === 0)}}">上一篇</button><button disabled="{{moving}}" class="primary" data-action="{{modal.page === 5 ? 'close' : 'history-next'}}" bindtap="onAction">{{modal.page === 5 ? '返回首页' : '下一篇'}}</button></block><block xhs:elif="{{modal.kind === 'move'}}"><button disabled="{{moving}}" class="secondary" data-action="close" bindtap="onAction">返回</button><button disabled="{{moving}}" xhs:if="{{modal.canMove}}" class="primary" data-action="confirm-move" bindtap="onAction">确认前往</button></block>
<block xhs:elif="{{modal.kind === 'lesson'}}"><button disabled="{{moving}}" class="secondary" data-action="skip-tutorial" bindtap="onAction">跳过教学</button><button disabled="{{moving}}" class="primary" data-action="lesson-next" bindtap="onAction">知道了</button></block>
<block xhs:elif="{{modal.kind === 'hint'}}"><button disabled="{{moving}}" class="secondary" data-action="close" bindtap="onAction">返回游戏</button><button class="primary" data-action="hint-next" bindtap="onAction" disabled="{{moving || (hintLevel >= 2)}}">{{hintLevel === 1 ? '查看参考解法' : '再提示一点'}}</button></block>
<block xhs:elif="{{modal.kind === 'rules'}}"><button class="secondary" data-action="rule-prev" bindtap="onAction" disabled="{{moving || (modal.page === 0)}}">上一页</button><button disabled="{{moving}}" class="primary" data-action="{{modal.page === modal.count-1 ? 'close' : 'rule-next'}}" bindtap="onAction">{{modal.page === modal.count-1 ? '返回游戏' : '下一页'}}</button></block>
<button disabled="{{moving}}" xhs:else class="primary" data-action="close" bindtap="onAction">返回</button>
</view></view></view>
</view>

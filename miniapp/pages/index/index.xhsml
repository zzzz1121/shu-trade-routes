<view xhs:if="{{ready}}" class="shell {{story && screen === 'play' ? 'story-shell' : ''}} {{modal.source === 'v4' ? 'dialogue-active' : ''}}">
<view xhs:if="{{screen === 'home'}}" class="title-home"><image class="title-landscape" src="/assets/art-v34/home-town.png" mode="aspectFill"/><view class="title-mast"><text>行商札记</text><view class="home-title-v4">蜀地钱路</view><view>钱有轻重，路有远近。</view></view><view class="title-actions"><button class="primary" data-action="embark" bindtap="onAction">启程</button><view class="row"><button class="text-button" data-action="sounds" bindtap="onAction">声音</button><button class="text-button" data-action="clear-cache" bindtap="onAction">删除缓存</button></view><view>{{message}}</view></view></view>
<scroll-view xhs:elif="{{screen === 'chapters'}}" class="chapter-scroll" scroll-y><view class="row"><view class="home-title-v4 chapter-title">行商六记</view><button class="text-button" data-action="home" bindtap="onAction">首页</button></view><view class="journey-count">已完成 {{completedCount}} / 6 程</view><view class="journey-road"><button xhs:for="{{chapters}}" xhs:key="id" class="journey-stop {{!item.locked && !item.completed ? 'featured' : ''}} {{item.locked ? 'locked' : ''}}" disabled="{{item.locked}}" data-action="{{'chapter-open:' + item.id}}" bindtap="onAction"><text class="journey-number">{{item.number}}</text><view class="journey-scene"><image src="{{item.scene}}" style="{{item.artStyle}}" mode="scaleToFill"/></view><view class="journey-label"><view class="stop-v4-title">{{item.title}}</view><view>{{item.subtitle}}</view><view>{{item.locked ? '未解锁' : item.resumable ? '继续行程' : item.completed ? '已完成 · 重走' : '启程'}}</view></view></button></view></scroll-view>
<view xhs:elif="{{screen === 'opening'}}" class="chapter-stage"><image class="opening-scenery" src="/assets/art-v34/merchant-room.png" mode="aspectFill"/><view class="opening-heading"><text>第一程 · 初入商路</text><view class="opening-title">布匹之约</view></view><view class="opening-cast actor-frame" style="{{openingActor.aspectStyle}}"><image src="{{openingActor.portrait}}" style="{{openingActor.frameStyle}}" mode="scaleToFill"/></view><view class="opening-copy"><view class="opening-quote"><text>罗掌柜</text><view>布铺给我们留了一批青布。阿禾带你认路，你来核货、付账。</view></view><view class="opening-mission"><image src="/assets/generated/cloth.png" mode="aspectFit"/><view>买齐青布，送至前堂<view>4 步以内 · 钱袋 5 格</view></view></view><button class="primary" data-action="opening-start" bindtap="onAction">开始上路</button></view></view>
<block xhs:elif="{{story}}"><view xhs:if="{{storyEnded || s.status === 'failed'}}" class="story-result settled-scene"><image class="result-scenery" src="/assets/art-v34/ending-town.png" mode="aspectFill"/><view class="eyebrow">第一章</view><view class="home-title-v4 chapter-title">{{s.status === 'won' ? '布匹之约' : '这趟，再想想'}}</view><view xhs:if="{{s.status === 'won'}}" class="completion-stamp">完成</view><view xhs:else class="result-cast actor-frame" style="{{resultActor.aspectStyle}}"><image src="{{resultActor.portrait}}" style="{{resultActor.frameStyle}}" mode="scaleToFill"/></view><view class="result-body"><view class="closing-quote"><text class="closing-name">{{s.status === 'won' ? '罗掌柜' : '阿禾'}}</text><view>{{s.status === 'won' ? '今日这笔，账在你写的那页。' : '退回前一步看看，或者重新配好货款。'}}</view></view><view xhs:if="{{s.status === 'won'}}" class="receipt"><image src="/assets/generated/cloth.png" mode="aspectFit"/><text>已交付青布 × 1</text></view><view class="account-summary"><view>实际路线：{{pathText}}</view><view class="row"><text>{{storyStats.steps}} / 4 步 · 剩余 {{remainingText}}</text><button class="text-button" data-action="ledger" bindtap="onAction">查看账簿</button></view></view><view class="result-actions"><button xhs:if="{{s.status === 'won'}}" class="primary" data-action="chapters" bindtap="onAction">继续旅程</button><button xhs:else class="primary" disabled="{{!canUndo}}" data-action="undo" bindtap="onAction">撤销上一步</button><view class="result-secondary"><button xhs:if="{{s.status === 'won'}}" class="text-button" data-action="stay" bindtap="onAction">留在商行</button><button class="text-button" data-action="story-retry" bindtap="onAction">重走一趟</button><button class="text-button" data-action="home" bindtap="onAction">返回首页</button></view></view></view></view><view xhs:else class="story-game {{s.nodeId === 'shop' ? 'at-shop' : ''}} {{storyPhase === 'road' || storyPhase === 'return' || story.tradeMap ? 'road-mode' : ''}}"><view class="story-hud"><button class="chapter-button" data-action="commission" bindtap="onAction"><text>第一程</text><text>布匹之约</text></button><view class="hud-counts">{{s.stepsUsed}} / 4 步　{{weight}} / 5 格</view><button class="text-button" data-action="menu" bindtap="onAction">更多</button></view><view class="story-objective">{{storyGoal}}</view><view xhs:if="{{storyRoom}}" class="warehouse-scene {{roomArtReady ? 'room-painted' : ''}}"><image class="room-painting" src="/assets/art-v34/warehouse-counter.png" mode="scaleToFill" bindload="onRoomArtLoad" binderror="onRoomArtError"/><view class="room-wall"></view><view class="room-window"><view></view></view><view class="room-shelf"></view><view class="room-floor"></view><view class="room-counter"><view class="counter-top"></view><view class="counter-front"></view></view><text class="room-place">罗记后仓</text><block xhs:for="{{roomObjects}}" xhs:key="id"><button xhs:if="{{item.active}}" class="room-item room-{{item.id}} interactive {{item.primary ? 'primary-object' : ''}}" data-action="{{item.action}}" aria-label="{{item.label}}" bindtap="onAction"><view class="room-item-art {{item.id}}-art"><view class="part-one"></view><view class="part-two"></view><view class="part-three"></view></view><text class="room-item-name">{{item.primary ? item.hint : item.label}}</text></button><view xhs:else class="room-item room-{{item.id}}"><view class="room-item-art {{item.id}}-art"><view class="part-one"></view><view class="part-two"></view><view class="part-three"></view></view></view></block></view><view xhs:elif="{{s.nodeId === 'shop' && (storyPhase === 'cloth' || storyPhase === 'payment') && !story.tradeMap}}" class="shop-stage"><image class="shop-scenery" src="/assets/art-v34/cloth-shop.png" mode="aspectFill"/><view class="shop-cast actor-frame" style="{{shopActor.aspectStyle}}"><image src="{{shopActor.portrait}}" style="{{shopActor.frameStyle}}" mode="scaleToFill"/></view><view class="shop-sign">布铺</view><button class="shop-map-link text-button" data-action="trade-map" bindtap="onAction">查看商路</button></view><view xhs:else class="map-stage"><view class="scene-continuation"><view class="continuation-frame"><image class="continuation-art" src="{{backdrop}}" mode="aspectFill"/></view></view><view class="map reference-map {{modular ? 'modular-map' : ''}} {{moving ? 'travelling' : ''}}"><view class="scene-art"><view class="scene-terrain"><view xhs:for="{{terrainTiles}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view><view class="scene-buildings"><view xhs:for="{{artRegions}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view></view><view class="road-layer"><view xhs:for="{{routeSegments}}" xhs:key="id" class="route route-dash {{item.walking ? 'walking-path' : ''}}" style="{{item.style}}"></view></view><view class="art-hit-layer"><button disabled="{{moving}}" xhs:for="{{artRegions}}" xhs:key="id" class="atlas-building-hit" style="{{item.style}}" data-building="{{item.id}}" bindtap="onMove"></button></view><view class="interaction-layer"><button disabled="{{moving}}" xhs:for="{{nodes}}" xhs:key="id" class="node scene-node {{item.current ? 'current' : ''}} {{item.reachable ? 'reachable' : ''}}" style="{{item.style}}" data-node="{{item.id}}" bindtap="onMove"><view class="scene-placard">{{item.name}}</view><view class="scene-pin"><view></view></view><view xhs:if="{{item.current}}" class="you-marker">所在</view></button></view><view xhs:if="{{showTraveler}}" xhs:for="{{mapActors}}" xhs:key="id" class="traveler traveler-{{item.id}} {{traveler.phase}}" style="{{item.style}}"><view class="traveler-shadow"></view><view class="traveler-offset"><view class="traveler-figure"><view class="traveler-cell"><image src="{{item.image}}" style="{{item.frameStyle}}" mode="scaleToFill"/></view></view></view></view></view></view><view xhs:if="{{storyBubble && !modal}}" class="map-bubble"><text>{{storyBubble}}</text><button class="text-button" data-action="bubble-close" bindtap="onAction">收起</button></view><view class="story-dock"><button class="purse-button" data-action="wallet" bindtap="onAction">铁钱 {{storyMoney.iron}}　交子 {{storyMoney.note}}　青布 {{storyMoney.cloth}}　{{storyRoom ? '货款明细' : '钱袋'}}</button><view xhs:if="{{storyPhase === 'prepare'}}" class="prepare-panel"><view class="row"><text>备好货款</text><button class="text-button" data-action="exchange-info" bindtap="onAction">兑换规矩</button></view><button class="secondary" data-action="draft-enable" bindtap="onAction">{{story.draftEnabled ? '已选兑换' : '不兑换'}}</button><view xhs:if="{{story.draftEnabled}}" class="stepper"><button class="small" disabled="{{storyDraftX <= 2}}" data-action="x-" bindtap="onAction">−</button><text>{{storyDraftX}} 铁钱 → {{storyDraftX - 1}} 交子</text><button class="small" disabled="{{storyDraftX >= 8}}" data-action="x+" bindtap="onAction">+</button></view><view>布钱6，至少2铁钱；过桥另备1铁钱。</view><view>带出 {{draft.iron}} 铁钱、{{draft.note}} 交子 · 负重 {{draft.load}}/5 · 手续费 {{draft.fee}}</view><button class="primary" disabled="{{!draft.canDepart}}" data-action="prepare-depart" bindtap="onAction">备好出发</button><view class="prepare-notes"><button class="text-button" data-action="object:note" bindtap="onAction">看看旧交子</button><button class="text-button" data-action="object:old-question" bindtap="onAction">问问旧票的事</button></view></view><view xhs:elif="{{paymentVisible}}" class="payment-panel"><view class="row"><text>布钱 {{storyPayIron + storyPayNote}} / 6</text><button class="text-button" data-action="trade-close" bindtap="onAction">先收起</button></view><view>至少付2铁钱 · 青布重2格</view><view class="payment-controls"><view xhs:for="{{storySteppers}}" xhs:key="key" class="stepper"><button class="small" disabled="{{item.minDisabled}}" data-action="{{item.minus}}" bindtap="onAction">−</button><text>{{item.label}} {{item.value}}</text><button class="small" disabled="{{item.maxDisabled}}" data-action="{{item.plus}}" bindtap="onAction">+</button></view></view><view>{{storyPaymentText}}</view><button class="primary" disabled="{{!storyPayment.ok}}" data-action="transact" bindtap="onAction">付清，收好布</button></view><view xhs:elif="{{!storyRoom}}" class="object-actions"><button xhs:for="{{storyObjects}}" xhs:key="id" class="secondary" disabled="{{item.disabled}}" data-action="{{item.action}}" bindtap="onAction">{{item.label}}</button><button xhs:if="{{story.flags.deliveryReady && s.status === 'playing' && s.nodeId === 'delivery'}}" class="primary" data-action="deliver" bindtap="onAction">确认交付</button></view><view class="dock-tools"><button class="text-button" disabled="{{!canUndo}}" data-action="undo" bindtap="onAction">撤销上一步</button><button class="text-button" data-action="hint" bindtap="onAction">问阿禾</button></view></view><view xhs:if="{{error && message}}" class="story-toast">{{message}}</view></view></block>
<view xhs:elif="{{screen === 'intro'}}" class="chapter-opening"><view class="opening-heading"><view class="eyebrow">第 {{level.number}} 关 / {{narrative.tag}}</view><view class="opening-title">{{level.title}}</view><view class="opening-line">{{narrative.line}}</view></view><view class="story-visual"><view class="vignette-scene scene-window"><image src="{{narrative.scene}}" style="{{narrative.sceneStyle}}" mode="scaleToFill"/></view><view class="vignette-wash"></view><view class="hero-portrait actor-frame" style="{{narrative.speaker.aspectStyle}}"><image src="{{narrative.speaker.portrait}}" style="{{narrative.speaker.frameStyle}}" mode="scaleToFill"/></view><view class="vignette-caption"><text class="eyebrow">{{narrative.tag}}</text><text>{{narrative.subtitle}}</text></view></view><view class="commission-card"><view class="speaker-line"><text class="speaker-name">{{narrative.speaker.name}}</text><text class="speaker-role">{{narrative.speaker.role}}</text></view><view class="commission-dialogue">{{narrative.opening}}</view><view class="commission-details"><view class="commission-goal">{{level.mission}}</view><view class="commission-limits"><text>{{level.maxSteps}} 步内送达</text><text>钱袋 {{level.capacity}} 格</text></view></view></view><view class="approach-picker"><text>行商打算 · 可选</text><view><button disabled="{{moving}}" class="{{plan === 'speed' ? 'primary' : 'secondary'}}" data-action="plan:speed" bindtap="onAction">{{approach.speed}}</button><button disabled="{{moving}}" class="{{plan === 'economy' ? 'primary' : 'secondary'}}" data-action="plan:economy" bindtap="onAction">{{approach.economy}}</button></view></view><view class="opening-actions"><button disabled="{{moving}}" class="primary" data-action="play" bindtap="onAction">开始委托</button><button disabled="{{moving}}" class="text-button" data-action="skip-intro" bindtap="onAction">跳过教学，直接开始</button></view></view>
<view xhs:elif="{{s.status !== 'playing'}}" class="result-screen"><view class="eyebrow">第 {{level.number}} 关 · {{level.title}}</view><view class="cover-title">{{s.status === 'won' ? '委托完成' : '行程未成'}}</view><view class="character-response {{historyLine ? 'history-response' : ''}}"><view class="portrait actor-frame" style="{{outroActor.aspectStyle}}"><image src="{{outroActor.portrait}}" style="{{outroActor.frameStyle}}" mode="scaleToFill"/></view><view class="response-copy"><view class="response-name">{{outroActor.name}}</view><view class="response-body">{{outroText}}</view><view xhs:if="{{historyLine}}" class="history-line">{{historyLine}}</view></view></view><view xhs:if="{{s.status !== 'won'}}" class="result-copy">{{resultText}}</view><view class="result-stats"><view>行动<view>{{s.stepsUsed}} / {{level.maxSteps}}</view></view><view>剩余资金<view>{{total}}</view></view><view>费用<view>{{fee}}</view></view></view><view class="muted">{{remainingText}}</view><view class="path">{{pathText}}</view><view class="ledger"><view xhs:for="{{ledger}}" xhs:key="id" class="ledger-row">{{item.text}}</view></view><view xhs:if="{{s.status === 'won'}}" class="route-review">{{routeReview}}<view xhs:if="{{ending}}">{{ending}}</view></view><view xhs:if="{{plan}}" class="approach-result">{{approach.label}} · {{approach.met ? '也办到了' : '下趟再试试'}}</view><view class="result-buttons"><button disabled="{{moving}}" xhs:if="{{s.status === 'won'}}" class="primary" data-action="next" bindtap="onAction">{{nextLabel}}</button><view class="action-buttons"><button disabled="{{moving}}" class="secondary" data-action="retry" bindtap="onAction">重新挑战</button><button class="secondary" data-action="undo" bindtap="onAction" disabled="{{moving || (!canUndo)}}">{{s.status === 'won' ? '返回交付前' : '撤回上一步'}}</button></view><button disabled="{{moving}}" class="text-button" data-action="chapters" bindtap="onAction">返回章节</button></view></view>
<block xhs:else>
<view class="panel-terrain"><image src="{{backdrop}}" mode="widthFix"/></view>
<view class="topbar"><view class="row"><view><view class="brand">蜀地钱路</view><view class="chapter">第 {{level.number}} 关 · {{level.title}}</view></view><view class="top-actions"><button disabled="{{moving}}" class="menu-button" data-action="menu" bindtap="onAction">菜单</button></view></view><view class="mission"><text>{{level.mission}}</text><view class="journey-actions"><text class="steps">{{s.stepsUsed}} / {{level.maxSteps}} 步</text><button class="undo-action" data-action="undo" bindtap="onAction" disabled="{{moving || (!canUndo)}}"><text class="undo-symbol">↶</text><text class="undo-label">撤销</text></button></view></view></view>
<view class="map-stage"><view class="scene-continuation"><view class="continuation-frame"><image class="continuation-art" src="{{backdrop}}" mode="aspectFill"/></view></view><view class="map reference-map {{modular ? 'modular-map' : ''}} {{moving ? 'travelling' : ''}}"><view class="scene-art"><view class="scene-terrain"><view xhs:for="{{terrainTiles}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view><view class="scene-buildings"><view xhs:for="{{artRegions}}" xhs:key="id" class="scene-tile {{item.market ? 'market-sprite' : ''}}" style="{{item.style}}"><image src="{{atlas}}" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view></view><view class="road-layer"><view xhs:for="{{routeSegments}}" xhs:key="id" class="route route-dash {{item.walking ? 'walking-path' : ''}}" style="{{item.style}}"></view></view><view class="art-hit-layer"><button disabled="{{moving}}" xhs:for="{{artRegions}}" xhs:key="id" class="atlas-building-hit" style="{{item.style}}" data-building="{{item.id}}" bindtap="onMove"></button></view><view class="interaction-layer"><button disabled="{{moving}}" xhs:for="{{nodes}}" xhs:key="id" class="node scene-node {{item.current ? 'current' : ''}} {{item.reachable ? 'reachable' : ''}}" style="{{item.style}}" data-node="{{item.id}}" bindtap="onMove"><view class="scene-placard">{{item.name}}</view><view class="scene-pin"><view></view></view><view xhs:if="{{item.current}}" class="you-marker">所在</view></button></view><view xhs:if="{{showTraveler}}" xhs:for="{{mapActors}}" xhs:key="id" class="traveler traveler-{{item.id}} {{traveler.phase}}" style="{{item.style}}"><view class="traveler-shadow"></view><view class="traveler-offset"><view class="traveler-figure"><view class="traveler-cell"><image src="{{item.image}}" style="{{item.frameStyle}}" mode="scaleToFill"/></view></view></view></view></view></view>
<view class="dock"><view class="wallet"><view xhs:for="{{resources}}" xhs:key="id" class="walletitem"><view xhs:if="{{item.asset}}" class="money-object"><image class="resource-icon" src="{{'/assets/generated/' + item.asset + '.png'}}" mode="aspectFit"/><text xhs:if="{{item.seal}}" class="note-seal {{item.id}}">{{item.seal}}</text></view><view xhs:else class="resource-icon goods-sprite"><image src="/assets/v2/goods.png" style="{{item.spriteStyle}}" mode="scaleToFill"/></view><view><view class="label">{{item.name}}</view><view class="resource-number">{{item.value}}</view></view></view><view class="load"><view class="label">随身负重</view><view>{{weight}} / {{level.capacity}}</view><view class="capacity"><view xhs:for="{{slots}}" xhs:key="id" class="slot {{item.kind}}"></view></view></view></view><view class="cargo-strip"><view xhs:for="{{cargo}}" xhs:key="id" class="cargo-item"><view xhs:if="{{item.asset}}" class="money-object"><image class="resource-icon" src="{{'/assets/generated/' + item.asset + '.png'}}" mode="aspectFit"/><text xhs:if="{{item.seal}}" class="note-seal {{item.id}}">{{item.seal}}</text></view><view xhs:else class="resource-icon goods-sprite"><image src="/assets/v2/goods.png" style="{{item.spriteStyle}}" mode="scaleToFill"/></view><text>{{item.name}} {{item.value}}</text></view></view>
<view xhs:if="{{message}}" class="feedback {{error ? 'error' : ''}}">{{message}}</view><view class="action-panel {{panel.kind}}"><view class="panel-heading"><view>{{panel.title}}</view><view class="muted">{{panel.meta}}</view></view><button disabled="{{moving}}" class="ask-guide" data-action="hint" bindtap="onAction"><view class="guide-face actor-frame" style="{{guide.aspectStyle}}"><image src="{{guide.portrait}}" style="{{guide.frameStyle}}" mode="scaleToFill"/></view><text>问阿禾</text></button><view class="payment-controls"><view xhs:for="{{panel.steppers}}" xhs:key="key" class="stepper {{item.key === 'x' ? 'exchange-stepper' : ''}}"><button class="small" data-action="{{item.minus}}" bindtap="onAction" disabled="{{moving || (item.minDisabled)}}">−</button><view class="stepper-value">{{item.label}}<view xhs:if="{{item.key !== 'x'}}" class="resource-number">{{item.value}}</view></view><button class="small" data-action="{{item.plus}}" bindtap="onAction" disabled="{{moving || (item.maxDisabled)}}">+</button></view></view><view xhs:if="{{panel.choices.length}}" class="choice-buttons"><button disabled="{{moving}}" xhs:for="{{panel.choices}}" xhs:key="id" class="{{item.selected ? 'primary' : 'secondary'}}" data-action="{{item.id}}" bindtap="onAction">{{item.label}}</button></view><view class="preview">{{panel.preview}}</view><view class="action-buttons"><button xhs:for="{{panel.buttons}}" xhs:key="id" class="{{item.kind}}" data-action="{{item.id}}" bindtap="onAction" disabled="{{moving || (item.disabled)}}">{{item.label}}</button></view></view>
</view>
</block>
<view xhs:if="{{modal.source === 'v4'}}" class="vn-overlay"><image class="vn-scenery" src="{{dialogueScenery}}" mode="aspectFill"/><view class="vn-dialog rules-dialog"><view xhs:if="{{modal.stageActor}}" class="vn-cast actor-frame cast-{{modal.stageActor.id}} {{modal.stageSilent ? 'listening' : ''}}" style="{{modal.stageActor.aspectStyle}}"><image src="{{modal.stageActor.portrait}}" style="{{modal.stageActor.frameStyle}}" mode="scaleToFill"/></view><view class="vn-toolbar"><button class="text-button" data-action="backlog" bindtap="onAction">回看</button><button class="text-button" disabled="{{!modal.canSkipRead}}" data-action="story-skip-read" bindtap="onAction">略过已读</button><button class="text-button" data-action="sounds" bindtap="onAction">声音</button><button class="text-button" data-action="dialogue-auto" bindtap="onAction">{{autoEnabled ? '停止自动' : '自动'}}</button></view><view class="vn-name">{{modal.title}}</view><button class="vn-text" disabled="{{modal.atEnd && modal.choices.length}}" data-action="dialogue-next" bindtap="onAction">{{modal.body}}</button><view class="vn-choices"><block xhs:if="{{modal.atEnd && modal.choices.length}}"><button xhs:for="{{modal.choices}}" xhs:key="id" class="secondary" data-action="{{'choice:' + item.id}}" bindtap="onAction">{{item.label}}</button></block><button xhs:else class="text-button" data-action="dialogue-next" bindtap="onAction">继续</button></view></view></view>
<view xhs:elif="{{modal.dialogue}}" class="modal-backdrop narrative-backdrop {{modal.important ? 'important-dialogue' : 'teaching-backdrop'}}"><view class="rules-dialog dialogue-card"><view class="dialogue-portrait actor-frame" style="{{modal.actor.aspectStyle}}"><image src="{{modal.actor.portrait}}" style="{{modal.actor.frameStyle}}" mode="scaleToFill"/></view><view class="dialogue-copy"><view class="eyebrow">{{modal.actor.role}}</view><view class="dialogue-name">{{modal.actor.name}}</view><view class="dialogue-body">{{modal.body}}</view></view><view class="dialog-toolbar"><button disabled="{{moving}}" class="text-button" data-action="backlog" bindtap="onAction">回看</button><button disabled="{{moving}}" xhs:if="{{modal.kind === 'story'}}" class="text-button" data-action="dialogue-skip" bindtap="onAction">跳过</button></view><view class="dialog-controls"><block xhs:if="{{modal.kind === 'lesson'}}"><button disabled="{{moving}}" class="secondary" data-action="skip-tutorial" bindtap="onAction">跳过教学</button><button disabled="{{moving}}" class="primary" data-action="lesson-next" bindtap="onAction">继续</button></block><block xhs:elif="{{modal.kind === 'hint'}}"><button disabled="{{moving}}" class="secondary" data-action="close" bindtap="onAction">返回游戏</button><button class="primary" data-action="hint-next" bindtap="onAction" disabled="{{moving || (hintLevel >= 2)}}">{{hintLevel === 1 ? '查看参考解法' : '再提示一点'}}</button></block><block xhs:elif="{{modal.kind === 'story'}}"><button disabled="{{moving}}" xhs:if="{{!modal.atEnd}}" class="primary" data-action="dialogue-next" bindtap="onAction">继续</button><block xhs:else><button disabled="{{moving}}" xhs:for="{{modal.choices}}" xhs:key="id" class="secondary" data-action="{{'choice:' + item.id}}" bindtap="onAction">{{item.label}}</button></block></block><button disabled="{{moving}}" xhs:else class="primary" data-action="close" bindtap="onAction">继续行商</button></view></view></view>
<view xhs:elif="{{modal.kind === 'backlog'}}" class="modal-backdrop"><view class="rules-dialog backlog-dialog"><view class="row"><view class="rule-title">对话回看</view><button disabled="{{moving}}" class="text-button" data-action="backlog-return" bindtap="onAction">返回对白</button></view><scroll-view scroll-y class="backlog-scroll"><view xhs:if="{{!backlog.length}}">听过的对白会记在这里。</view><view xhs:for="{{backlog}}" xhs:key="index" class="backlog-entry"><view xhs:if="{{item.actor.visible !== false}}" class="backlog-portrait actor-frame" style="{{item.actor.aspectStyle}}"><image src="{{item.actor.portrait}}" style="{{item.actor.frameStyle}}" mode="scaleToFill"/></view><view><view>{{item.speaker}}</view><view class="backlog-text">{{item.text}}</view></view></view></scroll-view></view></view>
<view xhs:elif="{{modal.kind === 'sound'}}" class="modal-backdrop sound-backdrop"><view class="rules-dialog sound-dialog"><view class="row"><view class="rule-title">声音</view><button class="text-button" data-action="close" bindtap="onAction">返回</button></view><view class="sound-setting"><text>剧情配乐</text><button class="secondary" data-action="sound:music" bindtap="onAction">{{soundSettings.musicEnabled ? '开启' : '关闭'}}</button></view><view class="sound-setting"><text>音乐音量</text><button class="small" data-action="sound:music-down" bindtap="onAction">−</button><text>{{musicVolumePercent}}%</text><button class="small" data-action="sound:music-up" bindtap="onAction">+</button></view><view class="sound-setting"><text>操作音效</text><button class="{{soundSettings.effectsEnabled ? 'primary' : 'secondary'}}" data-action="sound:effects" bindtap="onAction">{{soundSettings.effectsEnabled ? '开启' : '关闭'}}</button></view><view class="sound-setting"><text>环境氛围</text><button class="{{soundSettings.ambienceEnabled ? 'primary' : 'secondary'}}" data-action="sound:ambience" bindtap="onAction">{{soundSettings.ambienceEnabled ? '开启' : '关闭'}}</button></view><view class="sound-setting sound-volume"><text>音量</text><button class="small" disabled="{{volumePercent === 0}}" data-action="sound:down" bindtap="onAction">−</button><text class="volume-value">{{volumePercent}}%</text><button class="small" disabled="{{volumePercent === 100}}" data-action="sound:up" bindtap="onAction">+</button></view><button class="text-button" data-action="sound:retry" bindtap="onAction">重新启用声音</button></view></view>
<view xhs:elif="{{modal.kind === 'menu'}}" class="modal-backdrop menu-backdrop"><view class="rules-dialog journey-menu"><view class="row"><view class="rule-title">行商手记</view><button disabled="{{moving}}" class="text-button" data-action="close" bindtap="onAction">收起</button></view><view class="journey-menu-items"><button xhs:for="{{menuItems}}" xhs:key="action" class="secondary" data-action="{{item.action}}" bindtap="onAction"><text class="menu-icon">{{item.icon}}</text><text>{{item.label}}</text><text class="menu-chevron">›</text></button></view><button class="text-button" data-action="undo" disabled="{{!canUndo}}" bindtap="onAction">撤销上一步</button></view></view>
<view xhs:elif="{{modal}}" class="modal-backdrop {{modal.kind}}-backdrop"><view class="rules-dialog"><view class="row"><view class="eyebrow">行商札记</view><button disabled="{{moving}}" class="text-button" data-action="close" bindtap="onAction">关闭</button></view><view class="rule-title">{{modal.title}}</view><view xhs:if="{{modal.flavor}}" class="node-flavor"><view class="node-portrait actor-frame" style="{{modal.actor.aspectStyle}}"><image src="{{modal.actor.portrait}}" style="{{modal.actor.frameStyle}}" mode="scaleToFill"/></view><text>{{modal.flavor}}</text></view><view class="rule-body">{{modal.body}}</view><view xhs:if="{{modal.asset}}" class="prop-art {{modal.asset}}"><image xhs:if="{{modal.asset === 'iron'}}" src="/assets/generated/iron.png" mode="aspectFit"/><image xhs:elif="{{modal.asset === 'damp' || modal.asset === 'cloth-blue' || modal.asset === 'cloth-grey' || modal.asset === 'cloth-white'}}" src="/assets/generated/cloth.png" mode="aspectFit"/><view xhs:else>{{modal.asset === 'old-note' ? '蜀地交子 · 虚构票面' : modal.title}}</view></view><view class="dialog-controls">
<block xhs:if="{{modal.kind === 'prop'}}"><button class="primary" xhs:for="{{modal.actions}}" xhs:key="id" data-action="{{item.id}}" bindtap="onAction">{{item.label}}</button></block><button xhs:elif="{{modal.kind === 'legacy'}}" class="primary" data-action="legacy-restart" bindtap="onAction">重新开始第一关</button><button xhs:elif="{{modal.kind === 'clear-cache'}}" class="primary" data-action="confirm-clear" bindtap="onAction">确认删除本游戏记录</button><block xhs:elif="{{modal.kind === 'history'}}"><button class="secondary" data-action="history-prev" bindtap="onAction" disabled="{{moving || (modal.page === 0)}}">上一篇</button><button disabled="{{moving}}" class="primary" data-action="{{modal.page === 5 ? 'close' : 'history-next'}}" bindtap="onAction">{{modal.page === 5 ? '返回首页' : '下一篇'}}</button></block><block xhs:elif="{{modal.kind === 'move'}}"><view xhs:if="{{story && !modal.canMove && modal.nodeId === s.nodeId}}" class="object-actions"><button xhs:if="{{modal.nodeId === 'shop' && story.tradeMap}}" class="primary" data-action="shop-enter" bindtap="onAction">进入布铺</button><button xhs:for="{{storyObjects}}" xhs:key="id" class="secondary" disabled="{{item.disabled}}" data-action="{{item.action}}" bindtap="onAction">{{item.label}}</button></view><button disabled="{{moving}}" class="secondary" data-action="close" bindtap="onAction">返回</button><button disabled="{{moving}}" xhs:if="{{modal.canMove}}" class="primary" data-action="confirm-move" bindtap="onAction">确认前往</button></block>
<block xhs:elif="{{modal.kind === 'lesson'}}"><button disabled="{{moving}}" class="secondary" data-action="skip-tutorial" bindtap="onAction">跳过教学</button><button disabled="{{moving}}" class="primary" data-action="lesson-next" bindtap="onAction">知道了</button></block>
<block xhs:elif="{{modal.kind === 'hint'}}"><button disabled="{{moving}}" class="secondary" data-action="close" bindtap="onAction">返回游戏</button><button class="primary" data-action="hint-next" bindtap="onAction" disabled="{{moving || (hintLevel >= 2)}}">{{hintLevel === 1 ? '查看参考解法' : '再提示一点'}}</button></block>
<block xhs:elif="{{modal.kind === 'rules'}}"><button class="secondary" data-action="rule-prev" bindtap="onAction" disabled="{{moving || (modal.page === 0)}}">上一页</button><button disabled="{{moving}}" class="primary" data-action="{{modal.page === modal.count-1 ? 'close' : 'rule-next'}}" bindtap="onAction">{{modal.page === modal.count-1 ? '返回游戏' : '下一页'}}</button><button class="text-button" data-action="history" bindtap="onAction">交子史话</button></block>
<button disabled="{{moving}}" xhs:else class="primary" data-action="close" bindtap="onAction">返回</button>
</view></view></view>
<view xhs:if="{{transactionCue}}" class="trade-feedback"><image src="/assets/generated/cloth.png" mode="aspectFit"/></view>
</view>

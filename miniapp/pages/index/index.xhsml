<view class="shell">
<view xhs:if="{{screen === 'home'}}" class="cover"><view class="eyebrow">北宋蜀地 · 行商札记</view><view class="cover-title">蜀地钱路</view><view class="cover-copy">钱有轻重，路有取舍。</view><view class="cover-art approved-cover"><image src="/assets/approved/town-atlas.png" mode="aspectFit"/></view><view class="cover-bottom"><view class="chapter">第一关 · {{level.title}}</view><button class="primary" data-action="intro" bindtap="onAction">开始游戏</button></view></view>
<view xhs:elif="{{screen === 'intro'}}" class="intro-screen"><view class="eyebrow">今日委托</view><view class="cover-title">一车铁钱</view><view class="cover-copy">买一份布，送往商行。只有 {{level.maxSteps}} 步，钱袋承重 {{level.capacity}} 格。</view><image class="intro-art" src="/assets/generated/cloth.png" mode="aspectFit"/><view class="brief-rules"><view class="brief-item">轻装出发<view class="muted">8 铁钱在货仓，先兑换交子减重。</view></view><view class="brief-item">混合付款<view class="muted">布价 {{level.goods.price}}，至少付 {{level.goods.minIron}} 铁钱。</view></view><view class="brief-item">选择商路<view class="muted">桥路收1铁钱，街巷免费但多走一步。</view></view></view><button class="primary" data-action="play" bindtap="onAction">整理钱袋 →</button></view>
<view xhs:elif="{{s.status !== 'playing'}}" class="result-screen"><view class="eyebrow">{{s.status === 'won' ? '委托完成' : '再试一次'}}</view><view class="cover-title">{{s.status === 'won' ? '布已送达' : '行程未成'}}</view><image class="result-art" src="{{s.status === 'won' ? '/assets/generated/delivery.png' : '/assets/generated/warehouse.png'}}" mode="aspectFit"/><view>{{s.status === 'won' ? '这一程，钱与路都安排妥当。' : '步数已用尽，尚未携布抵达商行。'}}</view><view class="result-stats"><view>行动<view>{{s.steps}} / {{level.maxSteps}}</view></view><view>剩余资金<view>{{s.iron + s.note}}</view></view></view><view class="muted">{{s.iron}} 铁钱 · {{s.note}} 交子</view><view class="path">{{pathText}}</view><view class="result-buttons"><button class="primary" data-action="retry" bindtap="onAction">重新挑战</button><button class="secondary" data-action="undo" bindtap="onAction" disabled="{{!canUndo}}">撤销上一步</button></view></view>
<block xhs:else>
<view class="panel-terrain"><image src="/assets/approved/town-extended.png" mode="widthFix"/></view>
<view class="topbar"><view class="row"><view><view class="brand">蜀地钱路</view><view class="chapter">第一关 · {{level.title}}</view></view><button class="menu-button" data-action="rules" bindtap="onAction">规则</button></view><view class="mission"><text>{{s.bought ? '将布料送至交付商行' : '购买布料，送至商行'}}</text><text class="steps">{{s.steps}} / {{level.maxSteps}} 步</text></view></view>
<view class="map-stage"><view class="scene-continuation"><view class="continuation-frame"><image class="continuation-art" src="/assets/approved/town-extended.png" mode="aspectFill"/></view></view><view class="map reference-map"><view class="scene-art"><view class="scene-terrain"><view xhs:for="{{terrainTiles}}" xhs:key="id" class="scene-tile" style="{{item.style}}"><image src="/assets/approved/town-atlas.png" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view><view class="scene-buildings"><view xhs:for="{{artRegions}}" xhs:key="id" class="scene-tile" style="{{item.style}}"><image src="/assets/approved/town-atlas.png" style="{{item.imageStyle}}" mode="scaleToFill"/></view></view></view><view class="road-layer"><view xhs:for="{{routeSegments}}" xhs:key="id" class="route route-dash" style="{{item.style}}"></view></view><view class="art-hit-layer"><button xhs:for="{{artRegions}}" xhs:key="id" class="atlas-building-hit" style="{{item.style}}" data-building="{{item.id}}" bindtap="onMove"></button></view><view class="interaction-layer"><button xhs:for="{{nodes}}" xhs:key="id" class="node scene-node {{item.current ? 'current' : ''}} {{item.reachable ? 'reachable' : ''}}" style="{{item.style}}" data-node="{{item.id}}" bindtap="onMove"><view class="scene-placard">{{item.name}}</view><view class="scene-pin"><view></view></view><view xhs:if="{{item.current}}" class="you-marker">所在</view></button></view></view></view>
<view class="dock"><view class="wallet"><view class="walletitem"><image class="resource-icon" src="/assets/generated/iron.png" mode="aspectFit"/><view><view class="label">{{s.departed ? '铁钱' : '货仓铁钱'}}</view><view class="resource-number">{{s.iron}}</view></view></view><view class="walletitem"><image class="resource-icon" src="/assets/generated/note.png" mode="aspectFit"/><view><view class="label">交子</view><view class="resource-number">{{s.note}}</view></view></view><view class="walletitem"><image class="resource-icon" src="/assets/generated/cloth.png" mode="aspectFit"/><view><view class="label">布料</view><view class="resource-number">{{s.cloth}}</view></view></view><view class="load {{weight > level.capacity ? 'over' : ''}}"><view class="label">{{s.departed ? '负重' : '待装载'}}</view><view>{{weight}} / {{level.capacity}}</view><view class="capacity"><view xhs:for="{{slots}}" xhs:key="id" class="slot {{item.kind}}"></view></view></view></view>
<view xhs:if="{{message}}" class="feedback {{error ? 'error' : ''}}">{{message}}</view><view class="action-panel">
<block xhs:if="{{!s.departed}}"><view class="row"><view>货仓 · {{s.exchanged ? '准备出发' : '兑换交子'}}</view><view class="muted">{{s.exchanged ? '已兑换一次' : '手续费 ' + level.exchangeFee}}</view></view><block xhs:if="{{!s.exchanged}}"><view class="stepper"><button class="small" data-action="x-" bindtap="onAction" disabled="{{x &lt;= 2}}">−</button><view class="stepper-value">{{x}} 铁钱 → {{x-level.exchangeFee}} 交子</view><button class="small" data-action="x+" bindtap="onAction" disabled="{{x >= s.iron}}">+</button></view><view class="preview">{{exchangeText}}</view><view class="action-buttons"><button class="primary" data-action="exchange" bindtap="onAction" disabled="{{!exchangeOk}}">确认兑换</button><button class="secondary" data-action="depart" bindtap="onAction" disabled="{{weight > level.capacity}}">确认出发</button></view></block><block xhs:else><view class="ready-copy">{{preparationText}}</view><button class="primary" data-action="depart" bindtap="onAction" disabled="{{weight > level.capacity}}">确认出发</button></block></block>
<block xhs:elif="{{s.location === level.shop &amp;&amp; !s.bought}}"><view class="row"><view>布铺 · 购买布料</view><view class="muted">价 {{level.goods.price}} · 重 {{level.goods.weight}}</view></view><view class="stepper"><button class="small" data-action="p-" bindtap="onAction" disabled="{{p &lt;= 0}}">−</button><view class="stepper-value">{{p}} 铁钱 + {{payNote}} 交子</view><button class="small" data-action="p+" bindtap="onAction" disabled="{{p >= level.goods.price}}">+</button></view><view class="preview">{{buyText}}</view><button class="primary" data-action="buy" bindtap="onAction" disabled="{{!buyOk}}">确认购买布料</button></block>
<block xhs:elif="{{s.location === level.goal}}"><view>交付商行</view><view class="ready-copy">{{s.bought ? '布料已备齐，可以交付了。' : '尚未购得布料，请先前往布铺。'}}</view><button class="primary" data-action="deliver" bindtap="onAction" disabled="{{!s.bought}}">交付布料 · 完成委托</button></block>
<view xhs:else class="travel-copy"><view class="eyebrow">{{locationName}}</view><view>{{s.bought ? '带上布料，送往商行' : '选择你的下一站'}}</view></view></view>
<view class="controls"><button class="text-button" data-action="undo" bindtap="onAction" disabled="{{!canUndo}}">撤销</button><button class="text-button" data-action="retry" bindtap="onAction">重试</button></view></view>
</block><view xhs:if="{{rules}}" class="modal-backdrop"><view class="rules-dialog"><view class="row"><view>行商须知</view><button class="text-button" data-action="rules" bindtap="onAction">关闭</button></view><view class="chapter">{{rulePage+1}} / 3</view><view class="rule-title">{{ruleTitle}}</view><view class="rule-body">{{ruleBody}}</view><view class="dialog-controls"><button class="secondary" data-action="rule-prev" bindtap="onAction" disabled="{{rulePage === 0}}">上一页</button><button class="primary" data-action="{{rulePage === 2 ? 'rules' : 'rule-next'}}" bindtap="onAction">{{rulePage === 2 ? '返回游戏' : '下一页'}}</button></view></view></view>
</view>